{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structure-preserving PDF ingestion output",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "hierarchy", "blocks", "assets", "links", "statistics"],
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
      "minItems": 4,
      "maxItems": 4
    },
    "block": {
      "type": "object",
      "additionalProperties": true,
      "required": ["block_id", "page_id", "page_number", "section_id", "type", "bbox", "reading_order"],
      "properties": {
        "block_id": {"type": "string"},
        "page_id": {"type": "string"},
        "page_number": {"type": "integer", "minimum": 1},
        "section_id": {"type": "string"},
        "type": {"enum": ["heading", "text", "image", "table"]},
        "bbox": {"$ref": "#/$defs/bbox"},
        "reading_order": {"type": "integer", "minimum": 1},
        "text": {"type": "string"}
      }
    }
  },
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": ["document_id", "source_file", "source_path", "source_sha256", "page_count", "ingested_at", "parser_version"],
      "properties": {
        "document_id": {"type": "string"},
        "source_file": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page_count": {"type": "integer", "minimum": 1},
        "ingested_at": {"type": "string", "format": "date-time"},
        "parser_version": {"type": "string", "minLength": 1}
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "sections"],
      "properties": {
        "pages": {"type": "array", "items": {"type": "object"}},
        "sections": {"type": "array", "items": {"type": "object"}}
      }
    },
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "tables"],
      "properties": {
        "images": {"type": "array", "items": {"type": "object"}},
        "tables": {"type": "array", "items": {"type": "object"}}
      }
    },
    "links": {"type": "array", "items": {"type": "object"}},
    "statistics": {"type": "object"}
  }
}
